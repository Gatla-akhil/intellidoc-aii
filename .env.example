# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intellidoc?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth & Security
JWT_SECRET="intellidoc-super-secret-jwt-key-2026-production-secure"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="intellidoc-refresh-secret-2026"

# AI Models Setup
# Google Gemini 2.5 Pro / Flash Key
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI Key (Optional)
OPENAI_API_KEY="your-openai-api-key-here"

# Storage Configuration
CLOUDINARY_CLOUD_NAME="intellidoc"
CLOUDINARY_API_KEY="your-cloudinary-key"
CLOUDINARY_API_SECRET="your-cloudinary-secret"

# OCR Provider Configuration
OCR_ENGINE="vision" # vision | tesseract | mock
