generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  USER
  ADMIN
  AUDITOR
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum DocumentCategory {
  INVOICE
  BILL
  MEDICAL_REPORT
  RESEARCH_PAPER
  CONTRACT
  BANK_STATEMENT
  TAX_DOCUMENT
  CERTIFICATE
  PASSPORT
  IDENTITY_CARD
  DRIVING_LICENSE
  RESUME
  OFFER_LETTER
  LEGAL_DOCUMENT
  INSURANCE_PAPER
  PURCHASE_ORDER
  RECEIPT
  UTILITY_BILL
  BUSINESS_REPORT
  OTHER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  avatarUrl    String?
  role         Role          @default(USER)
  apiKey       String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  documents    Document[]
  chatSessions ChatSession[]
  auditLogs    AuditLog[]
}

model Workspace {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime   @default(now())
  documents Document[]
}

model Document {
  id              String           @id @default(uuid())
  title           String
  originalName    String
  fileType        String
  category        DocumentCategory @default(OTHER)
  fileUrl         String
  fileSize        Int
  status          DocumentStatus   @default(PENDING)
  confidenceScore Float            @default(0.95)
  isFraud         Boolean          @default(false)
  fraudReason     String?
  hasSignature    Boolean          @default(false)
  hasStamp        Boolean          @default(false)
  piiCount        Int              @default(0)
  summary         String?
  rawText         String?
  workspaceId     String?
  uploaderId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  uploader        User              @relation(fields: [uploaderId], references: [id])
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id])
  extractedFields ExtractedEntity[]
  versions        DocumentVersion[]
  comparisonsDoc1 ComparisonReport[] @relation("Doc1")
  comparisonsDoc2 ComparisonReport[] @relation("Doc2")
}

model ExtractedEntity {
  id            String   @id @default(uuid())
  documentId    String
  key           String
  value         String
  category      String   @default("General")
  confidence    Float    @default(0.95)
  isAnomalous   Boolean  @default(false)
  pageNumber    Int      @default(1)
  boundingBox   String?  // JSON string of { x, y, w, h }

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  versionNumber  Int
  fileUrl        String
  changesSummary String
  createdAt      DateTime @default(now())

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  role          String      // user | assistant | system
  content       String
  citationsJson String?     // JSON array of citation objects
  createdAt     DateTime    @default(now())

  session       ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

model ComparisonReport {
  id                  String   @id @default(uuid())
  title               String
  doc1Id              String
  doc2Id              String
  diffSummary         String
  fieldVariancesJson String   // JSON array of differences
  riskScore           Float    @default(0.1)
  createdAt           DateTime @default(now())

  doc1                Document @relation("Doc1", fields: [doc1Id], references: [id])
  doc2                Document @relation("Doc2", fields: [doc2Id], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model SystemMetric {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  activeUsers     Int
  docsProcessed   Int
  aiTokensUsed    Int
  avgProcessingMs Float
}
